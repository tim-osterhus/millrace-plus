            "READY",
            "NO_ACTION",
            "HOLD"
          ],
          "on": {
            "READY": {
              "goto": "prepare_baseline"
            },
            "NO_ACTION": {
              "goto": "retain"
            },
            "HOLD": {
              "goto": "hold"
            }
          },
          "on_error": {
            "pause": {
              "reason": "factory_hold",
              "resume": "reconcile"
            }
          },
          "on_unknown": {
            "pause": {
              "reason": "factory_hold",
              "resume": "reconcile"
            }
