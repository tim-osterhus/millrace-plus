{
  "format": "millrace-router/v4",
  "limits": {
    "max_parallel_invocations": 1
  },
  "bindings": {
    "command": {
      "adapter": "command",
      "contract": "millrace-command/v1",
      "executable": "python3",
      "config": {}
    },
    "investigate": {
      "adapter": "command",
      "contract": "millrace-command/v1",
      "executable": "cicd_agent",
      "config": {}
    },
    "repair": {
      "adapter": "command",
      "contract": "millrace-command/v1",
      "executable": "cicd_agent",
      "config": {}
    },
    "review": {
      "adapter": "command",
      "contract": "millrace-command/v1",
      "executable": "cicd_agent",
      "config": {}
    }
  },
  "control_files": [
    "scripts/step.py",
    "schemas/input.json",
    "context/contract.md"
  ],
  "planes": {
    "factory": {
      "workspace": "factory",
      "start": "reconcile",
      "nodes": {
        "claim": {
          "invoke": {
            "binding": "command",
            "config": {
              "script": "scripts/step.py",
              "args": [
                "claim"
              ]
            }
          },
          "result": "json-v1",
          "outcomes": [
            "CLAIMED",
            "EMPTY",
            "HOLD"
          ],
          "on": {
            "CLAIMED": {
              "goto": "normalize"
            },
            "EMPTY": {
              "goto": "wait_intake"
            },
            "HOLD": {
              "goto": "hold"
            }
          },
          "on_error": {
            "pause": {
              "reason": "factory_hold",
              "resume": "reconcile"
            }
          },
          "on_unknown": {
            "pause": {
              "reason": "factory_hold",
              "resume": "reconcile"
            }
          }
        },
        "wait_intake": {
