          "result": "json-v1",
          "outcomes": [
            "WAKE",
            "IDLE"
          ],
          "on": {
            "WAKE": {
              "goto": "claim"
            },
            "IDLE": {
              "goto": "claim"
            }
          },
          "on_error": {
            "pause": {
              "reason": "factory_hold",
              "resume": "reconcile"
            }
          },
